{
  "name": "simple-time-tracker-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "firebase emulators:exec --project demo-timer-sync --only firestore 'node --test tests/*.test.mjs'",
    "configure": "node scripts/configure.mjs",
    "provision": "node scripts/provision.mjs",
    "login": "firebase login",
    "demo": "firebase emulators:exec --project demo-timer-sync --only auth,firestore 'node scripts/demo.mjs'",
    "deploy": "npm run build && firebase deploy --only firestore:rules,firestore:indexes,hosting"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.29.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
